<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Apparatus.App</RootNamespace>
    <AssemblyName>Apparatus</AssemblyName>
    <Version>0.7.0</Version>
    <Product>Apparatus</Product>
    <Company>Apparatus</Company>
    <Description>Launcher, snippets, actions, Start menu</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\apparatus.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- We provide Main (single-instance check must run before XAML starts). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Only the parts of the Windows App SDK this app uses. The umbrella package also brings the AI, ML, Search and Widgets
      components (ONNX Runtime, DirectML...), about 60 MB that nothing here calls.
    -->
    <PackageReference Include="Microsoft.WindowsAppSDK.Base" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Foundation" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.DWrite" Version="2.7.0" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="2.7.0" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apparatus.Core\Apparatus.Core.csproj" />
    <ProjectReference Include="..\Apparatus.Native\Apparatus.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\apparatus.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\apparatus.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Samples\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
