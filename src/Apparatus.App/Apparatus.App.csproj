<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Apparatus.App</RootNamespace>
    <AssemblyName>Apparatus</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\apparatus.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- We provide Main (single-instance check must run before XAML starts). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Apparatus.Core\Apparatus.Core.csproj" />
    <ProjectReference Include="..\Apparatus.Native\Apparatus.Native.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\apparatus.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\apparatus.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
