<Window
    x:Class="Apparatus.App.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Configurações — Apparatus">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <ScrollViewer x:Name="Root" PreviewKeyDown="OnRootPreviewKeyDown">
        <StackPanel Padding="32,24,32,32" Spacing="8" MaxWidth="760" HorizontalAlignment="Stretch">

            <TextBlock Text="Configurações" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,8" />

            <!-- hotkey -->
            <TextBlock Text="Atalho do launcher" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,12,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Abrir o Apparatus em qualquer lugar" />
                            <TextBlock
                                x:Name="HotkeyHelp"
                                Text="Clique em Alterar e pressione a nova combinação."
                                FontSize="12"
                                Opacity="0.65"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            MinWidth="150"
                            Padding="14,6"
                            CornerRadius="6"
                            VerticalAlignment="Center"
                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1">
                            <TextBlock
                                x:Name="HotkeyText"
                                HorizontalAlignment="Center"
                                FontFamily="Consolas"
                                FontSize="15" />
                        </Border>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ChangeHotkeyButton" Content="Alterar" Click="OnChangeHotkey" />
                            <Button x:Name="ResetHotkeyButton" Content="Padrão" Click="OnResetHotkey" />
                        </StackPanel>
                    </Grid>
                    <InfoBar
                        x:Name="HotkeyInfo"
                        IsOpen="False"
                        IsClosable="False"
                        Severity="Error" />
                </StackPanel>
            </Border>

            <!-- general -->
            <TextBlock Text="Geral" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="14">
                    <ToggleSwitch
                        x:Name="AutostartSwitch"
                        Header="Iniciar com o Windows"
                        OnContent="Ativado"
                        OffContent="Desativado"
                        Toggled="OnAutostartToggled" />
                    <NumberBox
                        x:Name="MaxResultsBox"
                        Header="Resultados exibidos"
                        Minimum="3"
                        Maximum="12"
                        SmallChange="1"
                        SpinButtonPlacementMode="Inline"
                        Width="180"
                        HorizontalAlignment="Left"
                        ValueChanged="OnMaxResultsChanged" />
                    <ComboBox
                        x:Name="EngineBox"
                        Header="Pesquisa na web (quando nada corresponde)"
                        MinWidth="260"
                        DisplayMemberPath="Name"
                        SelectionChanged="OnEngineChanged" />
                    <TextBlock
                        Text="Atalhos de busca: g, yt, w, gh, maps — por exemplo “yt lofi” pesquisa no YouTube."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- snippets -->
            <TextBlock Text="Snippets" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="14">
                    <ToggleSwitch
                        x:Name="ExpansionSwitch"
                        Header="Expandir gatilhos ao digitar, em qualquer aplicativo"
                        OnContent="Ativado"
                        OffContent="Desativado"
                        Toggled="OnExpansionToggled" />
                    <TextBox
                        x:Name="ExcludedProcessesBox"
                        Header="Aplicativos onde nunca expandir (nome do processo, um por linha)"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        Height="100"
                        LostFocus="OnExcludedProcessesLostFocus" />
                    <TextBlock
                        Text="Campos de senha do Windows e o próprio Apparatus são sempre ignorados. Aplicativos em modo administrador não recebem a expansão."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                    <Button Content="Gerenciar snippets…" Click="OnOpenSnippets" />
                </StackPanel>
            </Border>

            <!-- files -->
            <TextBlock Text="Arquivos e pastas" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="14">
                    <ToggleSwitch
                        x:Name="IndexSwitch"
                        Header="Pesquisar arquivos e pastas"
                        OnContent="Ativado"
                        OffContent="Desativado"
                        Toggled="OnIndexToggled" />
                    <RadioButtons x:Name="RootsMode" Header="Onde procurar" SelectionChanged="OnRootsModeChanged">
                        <RadioButton Content="Automático — pastas do usuário e todos os discos fixos (exceto o do sistema)" />
                        <RadioButton Content="Somente as pastas abaixo" />
                    </RadioButtons>
                    <StackPanel x:Name="CustomRootsPanel" Spacing="8">
                        <ListView
                            x:Name="RootsList"
                            SelectionMode="Single"
                            MinHeight="60"
                            MaxHeight="160"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="6" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Adicionar pasta…" Click="OnAddRoot" />
                            <Button Content="Remover selecionada" Click="OnRemoveRoot" />
                        </StackPanel>
                    </StackPanel>
                    <TextBox
                        x:Name="ExcludedBox"
                        Header="Nomes de pastas ignoradas (uma por linha)"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        Height="120"
                        LostFocus="OnExcludedLostFocus" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Situação do índice" FontSize="12" Opacity="0.65" />
                        <TextBlock x:Name="IndexStatusText" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button x:Name="ReindexButton" Content="Reindexar agora" Click="OnReindex" />
                </StackPanel>
            </Border>

            <!-- clipboard -->
            <TextBlock Text="Área de transferência" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="14">
                    <ToggleSwitch
                        x:Name="ClipboardSwitch"
                        Header="Guardar um histórico do que eu copiar"
                        OnContent="Ativado"
                        OffContent="Desativado"
                        Toggled="OnClipboardToggled" />
                    <TextBlock
                        Text="Só texto, guardado apenas neste computador e cifrado com a sua conta do Windows (DPAPI). Digite “clip” no launcher para ver. Cópias que um gerenciador de senhas marca como privadas, e as feitas nos aplicativos listados abaixo, nunca são guardadas."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <NumberBox
                            x:Name="ClipboardMaxBox"
                            Header="Máximo de itens"
                            Minimum="20"
                            Maximum="5000"
                            SpinButtonPlacementMode="Inline"
                            Width="180"
                            ValueChanged="OnClipboardLimitsChanged" />
                        <NumberBox
                            x:Name="ClipboardDaysBox"
                            Header="Guardar por (dias)"
                            Minimum="1"
                            Maximum="365"
                            SpinButtonPlacementMode="Inline"
                            Width="180"
                            ValueChanged="OnClipboardLimitsChanged" />
                    </StackPanel>
                    <TextBox
                        x:Name="ClipboardExcludedBox"
                        Header="Aplicativos que nunca entram no histórico (nome do processo, um por linha)"
                        AcceptsReturn="True"
                        TextWrapping="NoWrap"
                        Height="90"
                        LostFocus="OnClipboardExcludedLostFocus" />
                    <Button Content="Limpar o histórico agora (itens fixados ficam)" Click="OnClearClipboard" />
                </StackPanel>
            </Border>

            <!-- assistant -->
            <TextBlock Text="Assistente de IA" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="14">
                    <ToggleSwitch
                        x:Name="AssistantSwitch"
                        Header="Responder perguntas e sugerir ações com uma IA (traga a sua própria chave)"
                        OnContent="Ativado"
                        OffContent="Desativado"
                        Toggled="OnAssistantToggled" />
                    <InfoBar
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Warning"
                        Title="O que você digitar no assistente é enviado ao provedor escolhido."
                        Message="Vão junto a conversa em andamento e a lista de páginas de configurações do Windows; nunca o histórico da área de transferência, seus snippets, arquivos ou caminhos. Os nomes das suas ações só se você permitir abaixo. Com o Ollama nada sai do computador. Nos planos gratuitos alguns provedores (o Google, por exemplo) podem usar o conteúdo para melhorar os produtos deles: confira os termos." />

                    <ComboBox
                        x:Name="AssistantProviderBox"
                        Header="Provedor"
                        MinWidth="340"
                        DisplayMemberPath="Label"
                        SelectionChanged="OnAssistantProviderChanged" />
                    <TextBlock x:Name="AssistantProviderNote" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />

                    <TextBox
                        x:Name="AssistantUrlBox"
                        Header="Endereço do servidor (formato OpenAI, termina em /v1)"
                        PlaceholderText="http://localhost:1234/v1"
                        Visibility="Collapsed"
                        LostFocus="OnAssistantUrlLostFocus" />

                    <StackPanel x:Name="AssistantKeyPanel" Spacing="8">
                        <PasswordBox
                            x:Name="AssistantKeyBox"
                            Header="Chave de API"
                            PlaceholderText="Cole a chave aqui"
                            Width="420"
                            HorizontalAlignment="Left"
                            PasswordChanged="OnAssistantKeyChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="AssistantSaveKeyButton" Content="Salvar chave" IsEnabled="False" Click="OnAssistantSaveKey" />
                            <Button x:Name="AssistantRemoveKeyButton" Content="Remover chave" Click="OnAssistantRemoveKey" />
                            <HyperlinkButton x:Name="AssistantGetKeyLink" Content="Obter uma chave" />
                        </StackPanel>
                        <TextBlock x:Name="AssistantKeyStatus" TextWrapping="Wrap" />
                        <TextBlock
                            Text="A chave fica só neste computador, cifrada com a sua conta do Windows (DPAPI). Não entra em backups, na pasta de sincronização nem no settings.json, e nunca é mostrada de volta. Isso protege contra outro usuário ou um backup copiado, não contra um programa rodando como você."
                            FontSize="12"
                            Opacity="0.65"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox
                            x:Name="AssistantModelBox"
                            Header="Modelo"
                            PlaceholderText="nome do modelo, por exemplo gemini-3.5-flash-lite"
                            Width="340"
                            KeyDown="OnAssistantModelKeyDown"
                            LostFocus="OnAssistantModelLostFocus" />
                        <Button x:Name="AssistantListButton" Content="Atualizar lista" VerticalAlignment="Bottom" Click="OnAssistantListModels" />
                    </StackPanel>
                    <ComboBox
                        x:Name="AssistantModelList"
                        Header="Modelos encontrados"
                        Width="340"
                        Visibility="Collapsed"
                        SelectionChanged="OnAssistantModelPicked" />
                    <TextBlock
                        x:Name="AssistantModelNote"
                        Text="Os modelos “flash-lite” do Gemini são os mais rápidos. A lista mostra só modelos de conversa; você também pode digitar o nome de qualquer modelo."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button x:Name="AssistantTestButton" Content="Testar conexão" Click="OnAssistantTest" />
                        <ProgressRing x:Name="AssistantBusy" IsActive="False" Width="20" Height="20" />
                    </StackPanel>
                    <TextBlock x:Name="AssistantStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    <InfoBar x:Name="AssistantResult" IsOpen="False" IsClosable="True" />

                    <ToggleSwitch
                        x:Name="AssistantKeepSwitch"
                        Header="Quando o launcher some, o que fazer com a conversa"
                        OnContent="Guardar por 15 minutos"
                        OffContent="Sempre começar do zero"
                        Toggled="OnAssistantKeepToggled" />
                    <TextBlock
                        Text="A conversa fica só na memória: nunca é gravada em disco e some quando o Apparatus fecha. Para usar o assistente, pressione Tab com a caixa de pesquisa vazia. Ctrl+N começa uma conversa nova."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />

                    <ToggleSwitch
                        x:Name="AssistantShareSwitch"
                        Header="Enviar os nomes das minhas ações ao provedor"
                        OnContent="Enviar"
                        OffContent="Não enviar"
                        Toggled="OnAssistantShareToggled" />
                    <TextBlock
                        Text="Permite que o assistente sugira executar uma das suas ações pelo nome. Só os nomes são enviados, nunca os passos, e nada é executado sem o seu clique."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />

                    <TextBlock x:Name="AssistantPromptText" FontSize="12" Opacity="0.65" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                    <Button Content="Abrir a pasta das instruções" HorizontalAlignment="Left" Click="OnAssistantOpenPromptFolder" />
                </StackPanel>
            </Border>

            <!-- quicklinks -->
            <TextBlock Text="Quicklinks e buscas na web" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Com {query} no destino, o atalho vira uma busca (“yt lofi” pesquisa no YouTube). Sem {query}, é um atalho que abre um site, uma pasta, um arquivo ou um programa quando você escolhe o nome no launcher."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                    <ListView
                        x:Name="QuicklinksList"
                        SelectionMode="Single"
                        MinHeight="80"
                        MaxHeight="220"
                        BorderThickness="1"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        CornerRadius="6" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Adicionar…" Click="OnAddQuicklink" />
                        <Button Content="Editar…" Click="OnEditQuicklink" />
                        <Button Content="Remover" Click="OnRemoveQuicklink" />
                        <Button Content="Restaurar padrões" Click="OnResetQuicklinks" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- extensions -->
            <TextBlock Text="Extensões" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="ExtensionsFolderText" FontSize="12" Opacity="0.65" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <StackPanel x:Name="ExtensionsList" Spacing="12" />
                    <TextBlock
                        x:Name="ExtensionsErrors"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Visibility="Collapsed" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Abrir a pasta" Click="OnOpenExtensionsFolder" />
                        <Button Content="Recarregar" Click="OnReloadExtensions" />
                        <Button Content="Restaurar o exemplo" Click="OnRestoreSample" />
                    </StackPanel>
                    <TextBlock
                        Text="Uma extensão é um programa que o Apparatus executa com as suas permissões. Nenhuma roda sem você ativá-la aqui; ative só as de fonte confiável."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- start menu -->
            <TextBlock Text="Menu Iniciar do Apparatus" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="14">
                    <ToggleSwitch
                        x:Name="StartKeySwitch"
                        Header="A tecla Windows abre o menu Iniciar do Apparatus"
                        OnContent="Ativado"
                        OffContent="Desativado"
                        Toggled="OnStartKeyToggled" />
                    <TextBlock
                        Text="Só o toque isolado na tecla Windows é tomado; Win+E, Win+D e os demais atalhos continuam como sempre. O menu original do Windows segue disponível com Ctrl+Esc. Desligar aqui devolve a tecla ao Windows na hora."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                    <ToggleSwitch
                        x:Name="StartClickSwitch"
                        Header="O clique no botão Iniciar da barra de tarefas também abre o menu do Apparatus"
                        OnContent="Ativado"
                        OffContent="Desativado"
                        Toggled="OnStartClickToggled" />
                    <InfoBar x:Name="StartStatus" IsOpen="False" IsClosable="False" />
                    <TextBlock x:Name="StartDiag" FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <ComboBox x:Name="StartThemeBox" Header="Tema" MinWidth="150" SelectionChanged="OnStartAppearanceChanged">
                            <ComboBoxItem Content="Como o sistema" Tag="system" />
                            <ComboBoxItem Content="Claro" Tag="light" />
                            <ComboBoxItem Content="Escuro" Tag="dark" />
                        </ComboBox>
                        <ComboBox x:Name="StartBackdropBox" Header="Fundo" MinWidth="150" SelectionChanged="OnStartAppearanceChanged">
                            <ComboBoxItem Content="Acrílico" Tag="acrylic" />
                            <ComboBoxItem Content="Mica" Tag="mica" />
                            <ComboBoxItem Content="Sólido" Tag="none" />
                        </ComboBox>
                        <ComboBox x:Name="StartPositionBox" Header="Posição" MinWidth="190" SelectionChanged="OnStartAppearanceChanged">
                            <ComboBoxItem Content="Junto ao botão Iniciar" Tag="taskbar" />
                            <ComboBoxItem Content="Centro da tela" Tag="center" />
                            <ComboBoxItem Content="Canto esquerdo" Tag="left" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="24">
                        <NumberBox
                            x:Name="StartColumnsBox"
                            Header="Itens por linha"
                            Minimum="4"
                            Maximum="8"
                            SmallChange="1"
                            SpinButtonPlacementMode="Inline"
                            Width="170"
                            ValueChanged="OnStartColumnsChanged" />
                        <ToggleSwitch
                            x:Name="StartRecentSwitch"
                            Header="Mostrar os mais usados"
                            OnContent="Sim"
                            OffContent="Não"
                            Toggled="OnStartAppearanceToggled" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Abrir o menu agora" Click="OnOpenStartMenu" />
                        <Button Content="Esvaziar os fixados…" Click="OnResetStartLayout" />
                    </StackPanel>
                    <TextBlock
                        Text="Para fixar: pesquise no menu (ou no launcher) e pressione Ctrl+P, ou use o botão direito. Arraste os itens para reordenar; mova entre seções pelo botão direito."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- windows taskbar and start tweaks -->
            <TextBlock Text="Barra de tarefas e Iniciar do Windows" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Ajustes do Windows 11 feitos pelo registro do seu usuário. O valor original é guardado na primeira alteração, e cada ajuste pode ser desfeito exatamente. Nada exige permissão de administrador."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                    <StackPanel x:Name="TweaksList" Spacing="12" />
                    <InfoBar x:Name="TweaksInfo" IsOpen="False" IsClosable="True" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Reiniciar o Explorer…" Click="OnRestartExplorer" />
                        <Button Content="Desfazer todos os ajustes" Click="OnRestoreAllTweaks" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- backup and sync -->
            <TextBlock Text="Backup e sincronização" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock
                        Text="Um arquivo .apparatus reúne as configurações, os snippets, as ações e o menu Iniciar. Não entram: histórico da área de transferência, estatísticas de uso, extensões, atalho do launcher, pastas indexadas e o que depende deste computador."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Exportar backup…" Click="OnExportBackup" />
                        <Button Content="Importar backup…" Click="OnImportBackup" />
                    </StackPanel>

                    <TextBlock Text="Pasta de sincronização" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock
                        Text="Escolha uma pasta que o OneDrive, o Dropbox ou similar já sincronize. O Apparatus grava lá o backup depois de cada alteração; no outro computador, você importa quando quiser. Um computador nunca sobrescreve alterações mais novas do outro sem você ter importado antes."
                        FontSize="12"
                        Opacity="0.65"
                        TextWrapping="Wrap" />
                    <TextBlock x:Name="SyncFolderText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Escolher pasta…" Click="OnChooseSyncFolder" />
                        <Button x:Name="SyncOffButton" Content="Desligar" Click="OnSyncOff" />
                        <Button x:Name="SyncNowButton" Content="Gravar agora" Click="OnSyncNow" />
                        <Button x:Name="SyncImportButton" Content="Importar da pasta…" Click="OnSyncImport" />
                    </StackPanel>
                    <TextBlock x:Name="SyncStatusText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    <InfoBar x:Name="BackupInfo" IsOpen="False" IsClosable="True" />
                </StackPanel>
            </Border>

            <!-- updates -->
            <TextBlock Text="Atualizações" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="12">
                    <TextBlock x:Name="VersionText" />
                    <TextBox
                        x:Name="UpdateSourceBox"
                        Header="De onde vêm as atualizações (pasta ou endereço web com os arquivos de release)"
                        PlaceholderText="por exemplo D:\releases ou https://exemplo.com/apparatus"
                        LostFocus="OnUpdateSourceLostFocus" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Verificar agora" Click="OnCheckUpdates" />
                        <Button x:Name="InstallUpdateButton" Content="Instalar e reiniciar" Click="OnInstallUpdate" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                    <TextBlock
                        Text="Sem uma fonte, nada é baixado. Quando há uma versão nova, o Apparatus avisa e você decide quando instalar; suas configurações e dados não são tocados."
                        FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- data -->
            <TextBlock Text="Dados" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,16,0,0" />
            <Border
                Padding="16"
                CornerRadius="8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1">
                <StackPanel Spacing="10">
                    <TextBlock x:Name="DataPathText" FontSize="12" Opacity="0.65" IsTextSelectionEnabled="True" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Limpar histórico" Click="OnClearHistory" />
                        <Button Content="Abrir pasta de dados" Click="OnOpenData" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
