<Window
    x:Class="Apparatus.App.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Apparatus.App">

    <Grid x:Name="Root" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="TileContainerStyle" TargetType="GridViewItem" BasedOn="{StaticResource DefaultGridViewItemStyle}">
                <Setter Property="Margin" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="RowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="48" />
                <Setter Property="Padding" Value="10,0" />
            </Style>

            <DataTemplate x:Key="TileTemplate" x:DataType="local:ResultItemViewModel">
                <StackPanel
                    Padding="2,10,2,0"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    Spacing="6"
                    ToolTipService.ToolTip="{x:Bind Title}">
                    <Grid Width="40" Height="40" HorizontalAlignment="Center">
                        <FontIcon
                            Glyph="{x:Bind Glyph}"
                            FontSize="26"
                            Opacity="0.8"
                            Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="40" Height="40" />
                    </Grid>
                    <TextBlock
                        Text="{x:Bind Title}"
                        FontSize="12"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        MaxLines="2"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ResultRowTemplate" x:DataType="local:ResultItemViewModel">
                <Grid Height="48" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="0.8" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" local:Highlight.Item="{x:Bind}" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind KindLabel}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AppRowTemplate" x:DataType="local:ResultItemViewModel">
                <Grid Height="48" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Letter}" FontSize="15" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Width="28" Height="28">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="0.8" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{x:Bind Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- search -->
        <Grid Grid.Row="0" Margin="24,22,24,10" Height="44" CornerRadius="22" Padding="16,0,12,0" ColumnSpacing="10"
              Background="{ThemeResource ControlFillColorDefaultBrush}"
              BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE721;" FontSize="15" Opacity="0.6" VerticalAlignment="Center" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="15"
                PlaceholderText="Pesquisar apps, arquivos, configurações…"
                BorderThickness="0"
                Background="Transparent"
                TextChanged="OnSearchTextChanged"
                PreviewKeyDown="OnSearchPreviewKeyDown">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
        </Grid>

        <!-- body: pinned (default), search results or the alphabetical list -->
        <Grid Grid.Row="1">
            <ScrollViewer x:Name="PinnedScroll" VerticalScrollBarVisibility="Auto" Padding="24,4,24,8">
                <StackPanel Spacing="4">
                    <StackPanel x:Name="SectionsPanel" Spacing="10" />
                    <TextBlock
                        x:Name="EmptyHint"
                        Visibility="Collapsed"
                        TextWrapping="Wrap"
                        Opacity="0.65"
                        FontSize="13"
                        Margin="0,8,0,8"
                        Text="Nada fixado ainda. Pesquise um aplicativo e pressione Ctrl+P, ou use “Todos os aplicativos” e o menu de contexto." />
                    <Button x:Name="NewSectionButton" Style="{StaticResource SubtleButtonStyle}" Click="OnNewSectionClick" Margin="-8,0,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                            <TextBlock Text="Nova seção" FontSize="12" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="RecentsHeader" Text="Recomendados" FontSize="13" FontWeight="SemiBold" Opacity="0.8" Margin="0,12,0,0" Visibility="Collapsed" />
                    <GridView
                        x:Name="RecentsGrid"
                        IsItemClickEnabled="True"
                        SelectionMode="Single"
                        Visibility="Collapsed"
                        ItemContainerStyle="{StaticResource TileContainerStyle}"
                        ItemTemplate="{StaticResource TileTemplate}"
                        ScrollViewer.VerticalScrollMode="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Hidden"
                        ItemClick="OnTileClick"
                        ContextRequested="OnTileContextRequested" />
                </StackPanel>
            </ScrollViewer>

            <ListView
                x:Name="ResultsList"
                Padding="16,0,16,8"
                Visibility="Collapsed"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemContainerStyle="{StaticResource RowContainerStyle}"
                ItemTemplate="{StaticResource ResultRowTemplate}"
                ItemClick="OnRowClick"
                ContextRequested="OnRowContextRequested" />

            <ListView
                x:Name="AllAppsList"
                Padding="16,0,16,8"
                Visibility="Collapsed"
                SelectionMode="Single"
                IsItemClickEnabled="True"
                ItemContainerStyle="{StaticResource RowContainerStyle}"
                ItemTemplate="{StaticResource AppRowTemplate}"
                ItemClick="OnRowClick"
                ContextRequested="OnRowContextRequested" />

            <TextBlock
                x:Name="NoResults"
                Visibility="Collapsed"
                Text="Nenhum resultado"
                Opacity="0.6"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="0,40,0,0" />
        </Grid>

        <!-- footer: quick shortcuts, all apps, power -->
        <Grid Grid.Row="2" Height="60" Padding="16,0,16,4" ColumnSpacing="8"
              Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel x:Name="QuickBar" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
            <Button x:Name="AllAppsButton" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}" Click="OnAllAppsClick" VerticalAlignment="Center">
                <TextBlock x:Name="AllAppsLabel" Text="Todos os aplicativos  ›" FontSize="12" />
            </Button>
            <Button x:Name="PowerButton" Grid.Column="2" Style="{StaticResource SubtleButtonStyle}" VerticalAlignment="Center"
                    ToolTipService.ToolTip="Energia">
                <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                <Button.Flyout>
                    <MenuFlyout x:Name="PowerMenu" />
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</Window>
