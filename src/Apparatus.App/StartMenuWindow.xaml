<Window
    x:Class="Apparatus.App.StartMenuWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Apparatus.App">

    <Grid x:Name="Root" PreviewKeyDown="OnRootPreviewKeyDown">
        <Grid.Resources>
            <Style x:Key="RowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="44" />
                <Setter Property="Padding" Value="8,0" />
                <Setter Property="Margin" Value="0" />
            </Style>

            <!-- pinned and recent apps: an optional small heading above the row (a section name, "Usados recentemente") -->
            <DataTemplate x:Key="PinnedRowTemplate" x:DataType="local:ResultItemViewModel">
                <StackPanel>
                    <TextBlock
                        Text="{x:Bind Header}"
                        Visibility="{x:Bind HeaderVisibility}"
                        FontSize="11"
                        Opacity="0.6"
                        Margin="2,10,0,4" />
                    <Grid Height="44" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="28" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="28" Height="28">
                            <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="0.8" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                            <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" />
                        </Grid>
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button
                        Grid.Column="2"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind TasksVisibility}"
                        Padding="8,6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Tarefas do aplicativo"
                        AutomationProperties.Name="Tarefas do aplicativo"
                        Click="OnTasksClick">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                    </Grid>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="ResultRowTemplate" x:DataType="local:ResultItemViewModel">
                <Grid Height="48" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="28" Height="28">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="0.8" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" local:Highlight.Item="{x:Bind}" />
                        <TextBlock Text="{x:Bind Subtitle}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{x:Bind KindLabel}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                    <Button
                        Grid.Column="3"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind TasksVisibility}"
                        Padding="8,6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Tarefas do aplicativo"
                        AutomationProperties.Name="Tarefas do aplicativo"
                        Click="OnTasksClick">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                </Grid>
            </DataTemplate>

            <DataTemplate x:Key="AppRowTemplate" x:DataType="local:ResultItemViewModel">
                <Grid Height="44" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26" />
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Letter}" FontSize="15" FontWeight="SemiBold" Opacity="0.7" VerticalAlignment="Center" />
                    <Grid Grid.Column="1" Width="28" Height="28">
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" Opacity="0.8" Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="28" Height="28" />
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{x:Bind Title}" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="3"
                        Style="{StaticResource SubtleButtonStyle}"
                        Visibility="{x:Bind TasksVisibility}"
                        Padding="8,6"
                        VerticalAlignment="Center"
                        ToolTipService.ToolTip="Tarefas do aplicativo"
                        AutomationProperties.Name="Tarefas do aplicativo"
                        Click="OnTasksClick">
                        <FontIcon Glyph="&#xE76C;" FontSize="11" />
                    </Button>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="268" />
        </Grid.ColumnDefinitions>

        <!-- left: apps, all programs, search -->
        <Grid Grid.Column="0" Padding="12,12,6,14" RowSpacing="6">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <ListView
                    x:Name="PinnedList"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemContainerStyle="{StaticResource RowContainerStyle}"
                    ItemTemplate="{StaticResource PinnedRowTemplate}"
                    ItemClick="OnRowClick"
                    ContextRequested="OnRowContextRequested" />

                <TextBlock
                    x:Name="EmptyHint"
                    Visibility="Collapsed"
                    TextWrapping="Wrap"
                    Opacity="0.65"
                    FontSize="13"
                    Margin="12,8,12,8"
                    VerticalAlignment="Top"
                    Text="Nada fixado ainda. Pesquise um aplicativo e pressione Ctrl+P, ou use “Todos os programas” e o menu de contexto." />

                <ListView
                    x:Name="ResultsList"
                    Visibility="Collapsed"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemContainerStyle="{StaticResource RowContainerStyle}"
                    ItemTemplate="{StaticResource ResultRowTemplate}"
                    ItemClick="OnRowClick"
                    ContextRequested="OnRowContextRequested" />

                <ListView
                    x:Name="AllAppsList"
                    Visibility="Collapsed"
                    SelectionMode="Single"
                    IsItemClickEnabled="True"
                    ItemContainerStyle="{StaticResource RowContainerStyle}"
                    ItemTemplate="{StaticResource AppRowTemplate}"
                    ItemClick="OnRowClick"
                    ContextRequested="OnRowContextRequested" />

                <TextBlock
                    x:Name="NoResults"
                    Visibility="Collapsed"
                    Text="Nenhum resultado"
                    Opacity="0.6"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,40,0,0" />
            </Grid>

            <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" VerticalAlignment="Top" Margin="8,0" />
            <Button
                x:Name="AllAppsButton"
                Grid.Row="1"
                Style="{StaticResource SubtleButtonStyle}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                Margin="0,4,0,0"
                Click="OnAllAppsClick">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <FontIcon x:Name="AllAppsChevron" Glyph="&#xE76C;" FontSize="12" />
                    <TextBlock x:Name="AllAppsLabel" Text="Todos os programas" FontSize="14" />
                </StackPanel>
            </Button>

            <Grid
                Grid.Row="2"
                Margin="2,0,0,0"
                Height="40"
                CornerRadius="8"
                Padding="12,0,10,0"
                ColumnSpacing="10"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <FontIcon Glyph="&#xE721;" FontSize="14" Opacity="0.6" VerticalAlignment="Center" />
                <TextBox
                    x:Name="SearchBox"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="14"
                    PlaceholderText="Pesquisar programas, arquivos e configurações"
                    BorderThickness="0"
                    Background="Transparent"
                    TextChanged="OnSearchTextChanged"
                    PreviewKeyDown="OnSearchPreviewKeyDown">
                    <TextBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                    </TextBox.Resources>
                </TextBox>
            </Grid>
        </Grid>

        <!-- right: the user, the places of the system, power -->
        <Grid Grid.Column="1" Padding="6,14,12,14" Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button
                x:Name="AvatarButton"
                Style="{StaticResource SubtleButtonStyle}"
                Width="68"
                Height="68"
                Padding="0"
                CornerRadius="34"
                HorizontalAlignment="Center"
                Margin="0,0,0,6"
                ToolTipService.ToolTip="Sua conta (configurações do Windows)"
                AutomationProperties.Name="Sua conta"
                Click="OnAvatarClick">
                <Grid Width="64" Height="64">
                    <Ellipse x:Name="AvatarEllipse" Fill="{ThemeResource ControlFillColorSecondaryBrush}" Stroke="{ThemeResource ControlStrokeColorDefaultBrush}" StrokeThickness="1" />
                    <FontIcon x:Name="AvatarGlyph" Glyph="&#xE77B;" FontSize="30" Opacity="0.85" />
                </Grid>
            </Button>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" IsTabStop="False">
                <StackPanel x:Name="PlacesPanel" Spacing="0" />
            </ScrollViewer>

            <Button
                x:Name="PowerButton"
                Grid.Row="2"
                Style="{StaticResource SubtleButtonStyle}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Left"
                ToolTipService.ToolTip="Energia">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="22" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon Glyph="&#xE7E8;" FontSize="16" />
                    <TextBlock Grid.Column="1" Text="Desligar" FontSize="14" VerticalAlignment="Center" />
                    <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.7" />
                </Grid>
                <Button.Flyout>
                    <MenuFlyout x:Name="PowerMenu" Placement="RightEdgeAlignedBottom" />
                </Button.Flyout>
            </Button>
        </Grid>
    </Grid>
</Window>
