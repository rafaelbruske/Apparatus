<Window
    x:Class="Apparatus.App.LauncherWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Apparatus.App"
    xmlns:assist="using:Apparatus.Core.Assistant">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="ResultItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="56" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="Margin" Value="0,0,0,0" />
            </Style>

            <local:ChatTemplateSelector x:Key="ChatTemplates">
                <local:ChatTemplateSelector.User>
                    <DataTemplate x:DataType="assist:ChatEntry">
                        <Border
                            HorizontalAlignment="Right"
                            MaxWidth="520"
                            Margin="60,4,0,4"
                            Padding="12,8"
                            CornerRadius="10"
                            Background="{ThemeResource AccentFillColorDefaultBrush}">
                            <TextBlock
                                Text="{x:Bind Display, Mode=OneWay}"
                                FontSize="14"
                                TextWrapping="Wrap"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                    </DataTemplate>
                </local:ChatTemplateSelector.User>
                <local:ChatTemplateSelector.Assistant>
                    <DataTemplate x:DataType="assist:ChatEntry">
                        <Border
                            HorizontalAlignment="Left"
                            MaxWidth="560"
                            Margin="0,4,40,4"
                            Padding="12,8"
                            CornerRadius="10"
                            Background="{ThemeResource ControlFillColorDefaultBrush}">
                            <TextBlock
                                Text="{x:Bind Display, Mode=OneWay}"
                                FontSize="14"
                                TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </local:ChatTemplateSelector.Assistant>
                <local:ChatTemplateSelector.Notice>
                    <DataTemplate x:DataType="assist:ChatEntry">
                        <TextBlock
                            Text="{x:Bind Display, Mode=OneWay}"
                            Margin="0,4"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Opacity="0.65"
                            TextWrapping="Wrap" />
                    </DataTemplate>
                </local:ChatTemplateSelector.Notice>
                <local:ChatTemplateSelector.Error>
                    <DataTemplate x:DataType="assist:ChatEntry">
                        <Border
                            Margin="0,4"
                            Padding="12,8"
                            CornerRadius="8"
                            Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}">
                            <TextBlock
                                Text="{x:Bind Display, Mode=OneWay}"
                                FontSize="13"
                                TextWrapping="Wrap" />
                        </Border>
                    </DataTemplate>
                </local:ChatTemplateSelector.Error>
                <local:ChatTemplateSelector.Suggestion>
                    <DataTemplate x:DataType="assist:ChatEntry">
                        <Grid Margin="0,3" HorizontalAlignment="Left" Width="460">
                            <Button
                                Click="OnSuggestionClick"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,8"
                                CornerRadius="8">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE76C;" FontSize="14" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{x:Bind Text, Mode=OneWay}" FontSize="14" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Detail}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="↵"
                                        FontSize="13"
                                        VerticalAlignment="Center"
                                        Opacity="0.65"
                                        Visibility="{x:Bind local:ChatView.Show(IsSelected), Mode=OneWay}" />
                                </Grid>
                            </Button>
                            <Border
                                IsHitTestVisible="False"
                                CornerRadius="8"
                                BorderThickness="2"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                                Visibility="{x:Bind local:ChatView.Show(IsSelected), Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </local:ChatTemplateSelector.Suggestion>
            </local:ChatTemplateSelector>

            <DataTemplate x:Key="ResultTemplate" x:DataType="local:ResultItemViewModel">
                <Grid Height="56" ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Width="32" Height="32">
                        <FontIcon
                            Glyph="{x:Bind Glyph}"
                            FontSize="22"
                            Opacity="0.8"
                            Visibility="{x:Bind GlyphVisibility, Mode=OneWay}" />
                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="32" Height="32" />
                    </Grid>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            FontSize="15"
                            TextTrimming="CharacterEllipsis"
                            local:Highlight.Item="{x:Bind}" />
                        <TextBlock
                            Text="{x:Bind Subtitle}"
                            FontSize="12"
                            Opacity="0.65"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <FontIcon Glyph="&#xE735;" FontSize="12" Opacity="0.8" Visibility="{x:Bind FavoriteVisibility}" />
                        <TextBlock Text="{x:Bind KindLabel}" FontSize="11" Opacity="0.5" />
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Padding="22,0,18,0" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="SearchIcon" Glyph="&#xE721;" FontSize="18" Opacity="0.6" VerticalAlignment="Center" />
            <TextBox
                x:Name="SearchBox"
                Grid.Column="1"
                VerticalAlignment="Center"
                FontSize="22"
                PlaceholderText="Pesquisar apps, arquivos, configurações…"
                BorderThickness="0"
                Background="Transparent"
                TextChanged="OnTextChanged"
                PreviewKeyDown="OnSearchPreviewKeyDown">
                <TextBox.Resources>
                    <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                    <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                    <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                </TextBox.Resources>
            </TextBox>
            <Button
                x:Name="CloseChatButton"
                Grid.Column="2"
                Visibility="Collapsed"
                VerticalAlignment="Center"
                Padding="6"
                Background="Transparent"
                BorderThickness="0"
                Opacity="0.6"
                ToolTipService.ToolTip="Fechar (Esc)"
                AutomationProperties.Name="Fechar o launcher"
                Click="OnCloseChatClick">
                <FontIcon Glyph="&#xE711;" FontSize="12" />
            </Button>
        </Grid>

        <Rectangle
            x:Name="Divider"
            Grid.Row="1"
            Height="1"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
            Visibility="Collapsed" />

        <ListView
            x:Name="ResultsList"
            Grid.Row="2"
            Padding="8,6,8,6"
            ItemsSource="{x:Bind Items}"
            ItemTemplate="{StaticResource ResultTemplate}"
            ItemContainerStyle="{StaticResource ResultItemStyle}"
            SelectionMode="Single"
            IsItemClickEnabled="True"
            ItemClick="OnItemClick"
            SelectionChanged="OnSelectionChanged"
            Visibility="Collapsed" />

        <Grid x:Name="ChatPanel" Grid.Row="2" Visibility="Collapsed">
            <TextBlock
                x:Name="ChatEmpty"
                Margin="32,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                TextAlignment="Center"
                TextWrapping="Wrap"
                FontSize="14"
                Opacity="0.65" />
            <ScrollViewer
                x:Name="ChatScroll"
                VerticalScrollBarVisibility="Auto"
                IsTabStop="False"
                Padding="18,8,18,8">
                <ItemsControl
                    x:Name="ChatItems"
                    IsTabStop="False"
                    ItemTemplateSelector="{StaticResource ChatTemplates}" />
            </ScrollViewer>
        </Grid>

        <Grid
            x:Name="Footer"
            Grid.Row="3"
            Height="36"
            Padding="22,0"
            Visibility="Collapsed">
            <TextBlock
                x:Name="HintsText"
                Text="↵ Abrir     Ctrl+↵ Mostrar na pasta     Esc Fechar"
                FontSize="11"
                Opacity="0.55"
                VerticalAlignment="Center" />
            <TextBlock
                x:Name="StatusText"
                FontSize="11"
                Opacity="0.55"
                HorizontalAlignment="Right"
                VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
